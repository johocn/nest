# ===== Application =====
NODE_ENV=development
APP_PORT=3000

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=game
DB_PASSWORD=game_password
DB_DATABASE=game_server
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=false

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT =====
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=12h

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Payment =====
PAYMENT_CALLBACK_SECRET=mock-secret-change-in-production

# ===== Admin =====
ADMIN_DEFAULT_PASSWORD=change-me-on-first-login

# ===== Game Config =====
GAME_INITIAL_GOLD=1000
GAME_INITIAL_DIAMOND=0
GAME_BAG_MAX_SLOTS=100
GAME_DAILY_QUEST_LIMIT=10
GAME_WS_HEARTBEAT_INTERVAL=30
GAME_WS_PING_TIMEOUT=90
GAME_VIEWPORT_RADIUS=10

# ===== Logging =====
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7
