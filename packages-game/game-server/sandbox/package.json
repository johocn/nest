{
  "name": "financial-sandbox",
  "version": "1.0.0",
  "description": "财商教育3D沙盘游戏",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/leaderboard-server.mjs",
    "test:server": "node server/leaderboard-server.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsc -p tsconfig.smoke.json && node .smoke-out/scripts/smoke.js",
    "page:check": "node scripts/page-check.mjs",
    "check": "npm run typecheck && npm run smoke && npm run test:server && npm run build && npm run page:check"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
